# Copy to .env and adjust. All variables are optional; defaults shown.
OCR_CONFIDENCE_THRESHOLD=0.80
OCR_PADDLE_PRIMARY_LANG=fr
OCR_TROCR_MODEL_NAME=microsoft/trocr-large-handwritten
OCR_PRE_GRAYSCALE=true
OCR_PRE_CLAHE=true
OCR_PRE_DENOISE=true
OCR_PRE_DESKEW=true
OCR_CACHE_DIR=./.ocr_cache
OCR_CACHE_TTL_SECONDS=604800
OCR_USE_GPU=false
OCR_MAX_UPLOAD_MB=25
OCR_LOG_LEVEL=INFO
# Set to require X-API-Key on /v1 routes; leave empty to disable.
OCR_API_KEY=
# PDF handling
OCR_PDF_RENDER_DPI=220
OCR_PDF_MAX_PAGES=50
